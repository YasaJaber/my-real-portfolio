GEMINI_API_KEY=your_gemini_api_key_here

# Distributed rate limiting for /api/chat (required in production unless CHAT_ALLOW_IN_MEMORY_RATE_LIMIT=true).
# Option A — Upstash: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B — Vercel KV / Redis (REST): same Redis REST API shape as Upstash (auto-injected when you connect storage in Vercel).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Only if you must run without Redis on serverless (unsafe: limits are per instance, abuse can slip through).
# CHAT_ALLOW_IN_MEMORY_RATE_LIMIT=true
